{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["mcp__serena__*", "Bash(git rm*)"],
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git branch *)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git worktree add*)",
      "Bash(git tag*)",
      "Bash(git cherry-pick*)"
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "theme": "dark"
}
