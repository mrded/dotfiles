{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "tui": "fullscreen",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "mcp__serena__*"
    ],
    "deny": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git restore*)",
      "Bash(git rm*)",
      "Bash(git stash*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git tag*)",
      "Bash(git cherry-pick*)"
    ]
  }
}
